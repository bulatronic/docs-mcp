# Path inside the container (compose secret mount). Do not put the JSON key contents here.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_sa.json

# Drive folder shared with the service account (Editor). ID from the folder URL.
DOCS_ROOT_FOLDER_ID=

# Keep false until smoke + Inspector checks pass (see README checklist).
DOCS_WRITE_ENABLED=false

# Comma-separated Google Doc IDs allowed for append (default-deny when empty).
DOCS_APPEND_ALLOWED_IDS=

DOCS_MAX_READ_CHARS=20000
DOCS_MAX_APPEND_CHARS=5000
TZ=Europe/Moscow
MCP_SESSION_DIR=/var/mcp-sessions
